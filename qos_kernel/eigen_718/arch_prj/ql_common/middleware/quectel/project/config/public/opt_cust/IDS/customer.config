# FRW customer options.
# Only override not-required feature components from EG800ZCN_LA target.config.

# Audio is not required.
#CONFIG_QCM_AUDIO_STREAM_FUNC=n
#CONFIG_QCM_AUDIO_MP3_FUNC=n
#CONFIG_QCM_AUDIO_AMR_FUNC=n
#CONFIG_QAPP_UNIRTOS_AT_QAUDIO_CMD=n

# LWM2M is not required.
CONFIG_QCM_LWM2M_FUNC=n
CONFIG_QCM_LWM2M_FOTA_FUNC=n
CONFIG_QCM_LWM2M_DTLS_FUNC=n
CONFIG_QCM_COAP_FUNC=n
CONFIG_QCM_COAP_API_FUNC=n
CONFIG_QAPP_UNIRTOS_LWM2M_AT_FUNC=n
CONFIG_QAPP_UNIRTOS_ONENET_LWM2M_AT_FUN=n
CONFIG_QAPP_UNIRTOS_AEP_LWM2M_AT_FUN=n
CONFIG_QAPP_UNIRTOS_COAP_AT_FUNC=n

# SMTP/SMTPS is not required.
CONFIG_QCM_QURL_SMTP_FUNC=n
CONFIG_QAPP_UNIRTOS_SMTP_AT_FUNC=n

# QUECTHING is not required.
CONFIG_QAPP_UNIRTOS_JD_AT_FUNC=n

# XLAT is not required.
CONFIG_QAPP_UNIRTOS_CLAT_AT_FUNC=n

# FIREWALL is required.
CONFIG_QCM_FIREWALL_FUNC=y
CONFIG_QCM_FIREWALL_TASK_STACK_SIZE=4096
CONFIG_QAPP_UNIRTOS_FIREWALL_AT_FUNC=y
