

CONFIG_QOSA_PPP_FUNC=n
CONFIG_QOSA_LED_FUNC=n
CONFIG_QOSA_USBHID_FUNC=y
CONFIG_QOSA_DTR_FUNC=n
# OPEN/CSDK default (only while build_oem is empty): eSIM function, no ESIM AT
CONFIG_QCM_ESIM_FUNC=y
# eSIM talks HTTPS to the SM-DP+/eIM: the VTLS wrapper is what gives qurl its
# TLS port (qurl_platform_config.h:67-71), and an OPEN package carries no AT
# chain that would select it, so it has to be enabled here. With it off the
# build still passes but the eSIM HTTPS client has no TLS backend at run time.
CONFIG_QCM_VTLS_FUNC=y
