menu "network"
depends on !(QOSA_BK7258_PLATFORM_FUNC || QOSA_BK7238_PLATFORM_FUNC || QOSA_ECR6600_PLATFORM_FUNC)

config QOSA_NW_GSM_SUPPORT
    bool "whether support GSM or not"
    default y

config QOSA_NW_WCDMA_SUPPORT
    bool "whether support WCDMA or not"
    default y

config QOSA_NW_LTE_SUPPORT
    bool "whether support LTE or not"
    default y

config QOSA_NW_NR_SUPPORT
    bool "whether support NR or not"
    default y

config QOSA_NW_LTE_ONLY
    bool "is LTE only module?"
    default n

config QOSA_NW_REJECT_CAUSE_SUPPORT
    bool "whether support reject cause or not"
    default y

config UNIRTOS_JAMM_DETECT_SHAKEPERIOD_DEFAULT
    int "default jamming detect"
    default 3
    range 1 10
    help
        default jamming detect supported by network

config UNIRTOS_JAMM_DETECT_RSSI_DEFAULT
    int "default jamming detect"
    default -50
    range -120 -20
    help
        default jamming detect supported by network

config UNIRTOS_JAMM_DETECT_RSSI_MAX
    int "maximum jamming detect"
    default -50
    range -120 -20
    help
        maximum jamming detect supported by network

config UNIRTOS_JAMM_DETECT_RSSI_MIN
    int "minimum jamming detect"
    default -50
    range -120 -20
    help
        minimum jamming detect supported by network

config UNIRTOS_JAMM_DETECT_RSRQ_DEFAULT
    int "default jamming detect"
    default -15
    range -20 0
    help
        default jamming detect supported by network

config UNIRTOS_JAMM_DETECT_RSRQ_MAX
    int "maximum jamming detect"
    default -15
    range -20 0
    help
        maximum jamming detect supported by network

config UNIRTOS_JAMM_DETECT_RSRQ_MIN
    int "minimum jamming detect"
    default -15
    range -20 0
    help
        minimum jamming detect supported by network

config UNIRTOS_JAMM_DETECT_RSRP_DEFAULT
    int "default jamming detect"
    default -105
    range -140 -44
    help
        default jamming detect supported by network

config UNIRTOS_JAMM_DETECT_SINR_DEFAULT
    int "default jamming detect"
    default -7
    range -50 63
    help
        default jamming detect supported by network

config UNIRTOS_JAMM_DETECT_SINR_MAX
    int "maximum jamming detect"
    default -7
    range -50 63
    help
        maximum jamming detect supported by network

config UNIRTOS_JAMM_DETECT_SINR_MIN
    int "minimum jamming detect"
    default -7
    range -50 63
    help
        minimum jamming detect supported by network

config QOSA_OPER_EUROPE_AREA
    bool "Europe Operator"
    default n
    help
      Enable Europe region operator configuration for QOSA.

config QOSA_OPER_LATIN_AMERICA_AREA
    bool "Latin America Operator"
    default n
    help
      Enable Latin America region operator configuration for QOSA.

config QOSA_OPER_NORTH_AMERICA_AREA
    bool "North America Operator"
    default n
    help
      Enable North America region operator configuration for QOSA.

config QOSA_OPER_OCEANIA_AREA
    bool "Oceania Operator"
    default n
    help
      Enable Oceania region operator configuration for QOSA.

config QOSA_OPER_ASIA_AREA
    bool "Asia Operator"
    default n
    help
      Enable Asia region operator configuration for QOSA (including India).

config QOSA_OPER_GL_AREA
    bool "Legacy global operator option (use Global Operator)"
    select QOSA_OPER_GLOBAL_AREA
    default n
    help
      Compatibility input for existing modem.config files using GL_AREA.
      New project configurations should use QOSA_OPER_GLOBAL_AREA.

config QOSA_OPER_GLOBAL_AREA
    bool "Global Operator"
    default n
    help
      Enable global operator configuration for QOSA.
      This allows the modem to use global network/PLMN settings.

endmenu
