menu "usbnet"
depends on !(QOSA_BK7258_PLATFORM_FUNC || QOSA_BK7238_PLATFORM_FUNC || QOSA_ECR6600_PLATFORM_FUNC)

config QOSA_USBNET_MBIM
    bool "MBIM"
    default n

config QOSA_USBNET_NCM
    bool "NCM"
    default n

config QOSA_USBNET_LIGHT_MODE
    bool "Light Mode"
    default n

endmenu
